# Скопируйте в .env и при необходимости измените значения.
# Файл .env не коммитится. Пустые значения игнорируются.

# Minimal API физлиц
PERSON_API_BASE_URL=http://localhost:5080
PERSON_API_TIMEOUT_SECONDS=30

# Локальная модель Ollama. Ключ API не нужен.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120

# Сколько шагов ReAct разрешено за один запрос (создание + список и т.п.).
AGENT_MAX_ACTIONS=6

# Необязательный провайдер OpenAI-совместимого API вместо Ollama.
# По умолчанию используется Ollama. Чтобы переключить консоль:
# LLM_PROVIDER=OpenAICompatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama
# LLM_TIMEOUT_SECONDS=120

# Необязательные интеграционные тесты живой модели.
# Если переменные не заданы, тесты пропускаются и не требуют Ollama.
# LLM_INTEGRATION_BASE_URL=http://localhost:11434/v1
# LLM_INTEGRATION_MODEL=llama3.1
# LLM_INTEGRATION_API_KEY=ollama
